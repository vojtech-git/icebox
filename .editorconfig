root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.cs]
csharp_new_line_before_open_brace = all

[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false
